APP_ENV=development
LLM_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_REASONING_EFFORT=medium
CORS_ORIGINS=http://localhost:3000

# PostgreSQL dành riêng cho tài khoản, phiên đăng nhập và audit.
# Ứng dụng dùng DATABASE_URL bằng tài khoản không có quyền đổi schema.
DATABASE_URL=
# Chỉ dùng cho lệnh Alembic thủ công; không tự chạy migration khi khởi động backend.
MIGRATION_DATABASE_URL=
DB_APP_ROLE=p113_app
SESSION_SECRET=
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# SQLite pipeline giữ nguyên các đường dẫn đang dùng; không chuyển sang PostgreSQL.
# STORE_PATH=./data/app.db
# CHECKPOINT_PATH=./data/checkpoints.db
# DATA_DIR=./data
# SOURCES_DIR=./data/sources
